# Скомпилированный питон. Важно не только из аккуратности: компилятор
# складывает константы, поэтому строки, намеренно склеенные из кусков в
# исходнике, лежат в .pyc целиком. Защита GitHub от секретов их справедливо
# ловит и отклоняет пуш — проверено на себе 21.08.2026.
__pycache__/
*.pyc

# Зависимости и сборка.
# bin/ здесь НЕТ намеренно: в проектах .NET это выхлоп, а в проектах на скриптах
# bin/ — каталог с кодом. 04.09.2026 наш набор перезаписал чужой .gitignore, и
# новые файлы в bin/ начали игнорироваться молча: уже отслеживаемые остались
# видны, а добавленные позже исчезли из git без единого сообщения.
node_modules/
**/bin/Debug/
**/bin/Release/
obj/
.venv/

# Локальные настройки — у каждого свои
.claude/settings.local.json
.vscode/

# Выхлоп и журналы
*.log
_proba*

# Значения секретов рядом с кодом не лежат никогда
.env
.env.*
!.env.example
