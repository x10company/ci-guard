#!/usr/bin/env bash
# Запуск сторожа из pre-commit. Код сторожа живёт в этом репозитории в одном
# экземпляре; в проверяемом репозитории лежит только ссылка с номером версии.
set -u

zdes="$(cd "$(dirname "$0")/.." && pwd)"

# Имя питона машинное: на маке бывает только python3, на Windows — python.
# Жёсткое имя означало бы, что на второй машине хук падает не на секретах, а на
# отсутствии интерпретатора, и код 1 «нет питона» неотличим от кода 1 «нашёл ключ».
piton="$(command -v python3 || command -v python || command -v py || true)"
if [ -z "$piton" ]; then
  echo "сторож ключей: питон не найден (искал python3, python, py)." >&2
  echo "сторож ключей: проверка НЕ выполнена — коммит остановлен." >&2
  exit 1
fi

# --koren обязателен. Сторож лежит в кэше pre-commit, а у того каталога свой
# .git: без явного корня git rev-parse отдаст корень сторожа, и он проверит сам
# себя, сообщив «чисто». pre-commit запускает хук из корня проверяемого
# репозитория, поэтому корень — это $PWD.
exec "$piton" "$zdes/tools/check-secrets.py" --staged --koren "$PWD"
