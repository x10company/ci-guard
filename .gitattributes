# Shell scripts: LF only, including the working copy.
# CRLF in .sh dies on the server with "bad interpreter"; local bash -n tolerates it.
*.sh   text eol=lf
*.bash text eol=lf

# PowerShell: CRLF, and write the file with a BOM.
# Windows PowerShell 5.1 reads a BOM-less file as ANSI and mangles Cyrillic.
*.ps1  text eol=crlf
